# OCUDU O-DU for a ProtO-RU soft O-RU on POWDER - rendered by bin/fh-setup.sh on @HOST@
# fronthaul @FH@ (@MY_MAC@) -> O-RU @PEER_MAC@, untagged; isolated cores @ISO@
cu_cp:
  amf:
    addrs: @AMF_ADDR@
    port: 38412
    bind_addrs: @AMF_BIND@
    supported_tracking_areas:
      - tac: @TAC@
        plmn_list:
          - plmn: "@PLMN@"
            tai_slice_support_list:
              - sst: 1
                sd: 1
ru_ofh:
  ru_bandwidth_MHz: @BW@
  t1a_max_cp_dl: 2435                      # ProtO-RU profile; > 1960 needs the T1a/Ta4 range patch
  t1a_min_cp_dl: 2250
  t1a_max_cp_ul: 2435
  t1a_min_cp_ul: 2250
  t1a_max_up: 2215
  t1a_min_up: 2050
  ta4_max: 1480
  ta4_min: 800
  is_prach_cp_enabled: true
  ignore_ecpri_payload_size: true
  compr_method_ul: bfp
  compr_bitwidth_ul: 9
  compr_method_dl: bfp
  compr_bitwidth_dl: 9
  compr_method_prach: bfp
  compr_bitwidth_prach: 9
  enable_ul_static_compr_hdr: true
  enable_dl_static_compr_hdr: true
  iq_scaling: 16.0
  cells:
    - network_interface: @FH@
      ru_mac_addr: @PEER_MAC@
      du_mac_addr: @MY_MAC@
      enable_promiscuous: true             # the AF_PACKET socket receives nothing otherwise
      dl_port_id: [0]
      ul_port_id: [0]
      prach_port_id: [4]
cell_cfg:
  dl_arfcn: @ARFCN@
  band: @BAND@
  channel_bandwidth_MHz: @BW@
  common_scs: 30
  plmn: "@PLMN@"
  tac: @TAC@
  pci: @PCI@
  nof_antennas_dl: 1
  nof_antennas_ul: 1
  prach:
    prach_config_index: 159                # short format B4: the only PRACH ProtO-RU supports
    prach_root_sequence_index: 1
    zero_correlation_zone: 0
    prach_frequency_start: 0
  tdd_ul_dl_cfg:
    dl_ul_tx_period: 5
    nof_dl_slots: 3
    nof_dl_symbols: 10
    nof_ul_slots: 1
    nof_ul_symbols: 2
expert_phy:
  allow_request_on_empty_uplink_slot: true
  max_proc_delay: 10
  pusch_dec_max_iterations: 15
metrics:
  enable_log: true
  layers:
    enable_ru: true
    enable_sched: true
  periodicity:
    du_report_period: 1000
log:
  filename: @RUN@/du.log
  all_level: warning
  ofh_level: info
pcap:                                      # gNB-side ground truth for the fronthaul decoder
  mac_enable: true
  mac_filename: /dev/shm/cap/gnb_mac.pcap
  ngap_enable: true
  ngap_filename: /dev/shm/cap/gnb_ngap.pcap
expert_execution:
  threads:
    main_pool:
      nof_threads: @NTHR@
  affinities:
    main_pool_cpus: @POOL@
    ofh:
      txrx_cpus: ["@OFH@"]
  cell_affinities:
    - ru_cpus: @RUCPUS@
